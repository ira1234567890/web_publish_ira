    },
    {
      "id": "poi_r20",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 17,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPoint", "Point"], true, false],
        [">=", ["get", "rank"], 20]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "subclass"],
          ["florist", "furniture"],
          ["get", "subclass"],
          ["get", "class"]
        ],
        "text-anchor": "top",
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["concat", ["get", "name:latin"], "\n", ["get", "name:nonlatin"]],
          ["coalesce", ["get", "name_en"], ["get", "name"]]
        ],
        "text-font": ["Noto Sans Italic"],
        "text-max-width": 9,
        "text-offset": [0, 0.6],
        "text-size": 12,
        "visibility": "visible"
      },
