      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "class"], "rail"],
        ["==", ["get", "brunnel"], "bridge"]
      ],
      "paint": {
        "line-color": "#bbb",
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          14,
          0.4,
          15,
          0.75,
          20,
          2
        ]
      }
    },
    {
      "id": "bridge_major_rail_hatching",
