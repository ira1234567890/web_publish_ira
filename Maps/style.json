      ],
      "paint": {
        "line-color": "#bbb",
        "line-dasharray": [0.2, 8],
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          14.5,
          0,
          15,
          3,
          20,
          8
        ]
      }
    },
    {
      "id": "road_transit_rail",
